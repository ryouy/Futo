rules_version = '2';

// クライアント（iOSアプリ・ブラウザ）からのFirestoreの読み書きは、すべて拒否する。
// 共有・フレンド機能は、サーバー（Vercel Functions + Admin SDK）のAPI経由だけで扱う。
// Admin SDKはこのルールを迂回するため、各APIが独立して、認証・認可・期限・所有者を検証する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
