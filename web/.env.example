# ふと — 共有・フレンド用サーバーの環境変数のテンプレート（秘密の値はここに書かない）
# 実際の値は、Vercel の Project Settings → Environment Variables に設定する。
# NEXT_PUBLIC_ で始まる変数は、ブラウザに公開されるため、秘密の値には使わない。

# --- Firebase Admin SDK（サーバーだけ）。サービスアカウントのJSONから、次の3つを取り出して設定する
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# 秘密鍵。改行は \n の文字のままで貼る（例："-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"）
FIREBASE_PRIVATE_KEY=

# --- 共有・招待リンクの土台（本番の安定したドメイン。Previewのドメインを指さない）
PUBLIC_BASE_URL=https://example.com

# --- Universal Links（AASA）。Apple Developer の Team ID と、アプリの Bundle ID
APPLE_TEAM_ID=
IOS_BUNDLE_ID=

# --- 匿名APIのレート制限で、IPをハッシュにするときのソルト（ランダムな長い文字列）
RATE_LIMIT_SALT=
